    "stage_P_coordinates_m":"float64[S,2] m",
    "stage_gap_jacobian_P":"float64[S,2,2] dimensionless",
    "stage_mass_cholesky_min_diagonal":"float64[S] native mixed diagnostic only",
    "stage_domain_and_sign_pass":"bool[S]"
