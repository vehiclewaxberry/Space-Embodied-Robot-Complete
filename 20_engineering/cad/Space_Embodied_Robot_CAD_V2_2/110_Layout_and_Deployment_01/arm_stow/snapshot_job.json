{
  "input": "arm_stow_layout.step",
  "mode": "view",
  "outputs": [
    {
      "path": "snapshots/arm_stow_isometric.png",
      "camera": "iso"
    },
    {
      "path": "snapshots/arm_stow_isometric_opposite.png",
      "camera": {
        "direction": [-1, 1, -0.8]
      }
    },
    {
      "path": "snapshots/arm_stow_top_orthographic.png",
      "camera": "top"
    },
    {
      "path": "snapshots/arm_stow_front_orthographic.png",
      "camera": "front"
    }
  ],
  "display": {
    "mode": "solid",
    "projection": "orthographic",
    "edges": {
      "color": "#1c2630"
    }
  },
  "render": {
    "viewLabels": true,
    "padding": 0.12,
    "sizeProfile": "assembly-large"
  }
}
