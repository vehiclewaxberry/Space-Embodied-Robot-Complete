{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "safety_request.schema.json",
  "title": "SafetyRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "timestamp",
    "state_estimate",
    "state_covariance",
    "candidate_id",
    "proposed_action",
    "model_level",
    "model_validity",
    "resource_state",
    "decision_deadline",
    "scenario_hash",
    "threshold_registry_hash"
  ],
  "properties": {
    "contract_version": {"const": "safety-gate-v1"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,96}$"},
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Request construction time. It is scenario-hash bound and must be between captured_at and evidence decision_time."
    },
    "state_estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "captured_at",
        "valid_until",
        "frame",
        "geometry_class",
        "mu",
        "omega_dps",
        "lambda_actual",
        "lambda_grid",
        "alpha",
        "contact_T_c_ms",
        "panel_f1_hz",
        "perception_branch"
      ],
      "properties": {
        "source": {"type": "string", "enum": ["HARNESS_TRUTH", "L2_ESTIMATOR"]},
        "captured_at": {"type": "string", "format": "date-time"},
        "valid_until": {"type": "string", "format": "date-time"},
        "frame": {"const": "SERVICER_BODY_RELATIVE"},
        "geometry_class": {"type": "string", "enum": ["G1_slender", "G2_cubesat", "G3_dense"]},
        "mu": {"type": "number"},
        "omega_dps": {
          "type": "number",
          "description": "Pre-capture target angular rate for a CAPTURE candidate; it must match the bound sim12 case row configuration."
        },
        "lambda_actual": {"type": "number"},
        "lambda_grid": {"type": "number", "enum": [0.2, 0.5, 1.0]},
        "alpha": {"type": "number"},
        "contact_T_c_ms": {"type": ["number", "null"]},
        "panel_f1_hz": {"type": ["number", "null"]},
        "perception_branch": {"type": "string", "enum": ["HARNESS_TRUTH", "L1_MARKER", "L2_MARKERLESS"]}
      }
    },
    "state_covariance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["representation", "diagonal", "assessment"],
      "properties": {
        "representation": {"const": "DIAGONAL_VARIANCES"},
        "diagonal": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"type": "number", "minimum": 0}
        },
        "assessment": {"type": "string", "enum": ["PASS", "FAIL", "UNKNOWN"]}
      }
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,96}$",
      "description": "Policy-registered candidate identifier, machine-bound to a sim12 result row and case configuration."
    },
    "proposed_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_action", "requested_modification"],
      "properties": {
        "task_action": {
          "type": "string",
          "enum": ["APPROACH", "CAPTURE", "POST_CAPTURE_STABILIZE", "DETUMBLE"]
        },
        "requested_modification": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "solver", "boundary_policy_id"],
              "properties": {
                "kind": {"const": "USE_EXACT_SOLVER"},
                "solver": {"const": "EXACT_SOLVER"},
                "boundary_policy_id": {"const": "MOD-EXACT-SOLVER-V1"}
              }
            }
          ]
        }
      }
    },
    "model_level": {"type": "string", "enum": ["L0", "L1", "L2"]},
    "model_validity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reported_status",
        "reported_in_domain",
        "certification",
        "selection_mode",
        "valid_until",
        "condition_language",
        "evaluated_conditions",
        "provisional_flags",
        "flex_status",
        "fallback_chain"
      ],
      "properties": {
        "reported_status": {"type": "string", "enum": ["PASS", "FAIL", "UNKNOWN"]},
        "reported_in_domain": {"type": ["boolean", "null"]},
        "certification": {"type": "string", "enum": ["CERTIFIED", "PROVISIONAL", "SCREENING_ONLY", "FAILED", "UNAVAILABLE"]},
        "selection_mode": {"type": "string", "enum": ["EXACT_SOLVER", "GRID_CELL"]},
        "valid_until": {"type": "string", "format": "date-time"},
        "condition_language": {"const": "STRUCTURED_V1"},
        "evaluated_conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["metric", "operator", "value", "unit"],
            "properties": {
              "metric": {"type": "string", "enum": ["IN_DOMAIN", "MODEL_GATE_PASS", "RESOURCE_GATE_PASS"]},
              "operator": {"type": "string", "enum": ["EQ"]},
              "value": {"type": "boolean"},
              "unit": {"const": "BOOLEAN"}
            }
          }
        },
        "provisional_flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9_:-]{1,96}$"}
        },
        "flex_status": {"type": "string", "enum": ["VALIDATED", "PROVISIONAL", "UNKNOWN_NOT_IN_CRITERIA"]},
        "fallback_chain": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target_level", "domain_checked", "reported_in_domain", "certification"],
            "properties": {
              "target_level": {"type": "string", "enum": ["L0", "L1"]},
              "domain_checked": {"type": "boolean"},
              "reported_in_domain": {"type": ["boolean", "null"]},
              "certification": {"type": "string", "enum": ["CERTIFIED", "PROVISIONAL", "SCREENING_ONLY", "FAILED", "UNAVAILABLE"]}
            }
          }
        }
      }
    },
    "resource_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "captured_at", "valid_until", "backoff_available"],
      "properties": {
        "status": {"type": "string", "enum": ["WITHIN_LIMITS", "EXCEEDED", "UNKNOWN"]},
        "captured_at": {"type": "string", "format": "date-time"},
        "valid_until": {"type": "string", "format": "date-time"},
        "backoff_available": {"type": "boolean"}
      }
    },
    "decision_deadline": {
      "type": "string",
      "format": "date-time",
      "description": "Scenario-hash-bound hard deadline; evidence decision_time must not exceed it."
    },
    "scenario_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "threshold_registry_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Frozen raw-byte SHA-256 of the threshold registry YAML; unlike Gate JSON, this hash is intentionally not canonicalized."
    }
  }
}
