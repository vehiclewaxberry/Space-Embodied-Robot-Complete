{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:space-embodied-agent:comp-prot-01:experience-memory:v1",
  "title": "Space Embodied Agent V1 Experience Memory",
  "$comment": "STATUS=PROTOTYPE_CONTRACT; advisory experience record only; it cannot cache, create or bypass execution authorization.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "taskSkill": {
      "type": "string",
      "enum": [
        "INTERCEPT_TARGET",
        "APPROACH_TARGET",
        "CAPTURE_TARGET",
        "STABILIZE_TARGET",
        "REDUCE_ROTATION",
        "TRANSFER_TARGET"
      ]
    },
    "physicsPrimitive": {
      "type": "string",
      "enum": [
        "approach_trajectory",
        "velocity_matching",
        "momentum_exchange",
        "grasp_closure",
        "attitude_compensation"
      ]
    }
  },
  "required": [
    "schema_version",
    "contract_status",
    "experience_id",
    "recorded_at",
    "task_context",
    "target_envelope_ref",
    "candidate_bundle_ref",
    "attempted_task_skill",
    "attempted_physics_primitives",
    "physics_response_ref",
    "safe_decision_ref",
    "outcome",
    "failure_mode",
    "physics_reason",
    "successful_skill",
    "reuse_condition",
    "memory_effect",
    "execution_authority"
  ],
  "properties": {
    "schema_version": {"const": "comp-prot-01.experience-memory.v1"},
    "contract_status": {"const": "PROTOTYPE_CONTRACT"},
    "experience_id": {"$ref": "#/$defs/identifier"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "task_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mission_line", "target_type", "scenario_hash", "context_tags"],
      "properties": {
        "mission_line": {
          "type": "string",
          "enum": ["debris_removal", "on_orbit_assembly", "both", "platform_common"]
        },
        "target_type": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
        "scenario_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "context_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"}
        }
      }
    },
    "target_envelope_ref": {"$ref": "#/$defs/identifier"},
    "candidate_bundle_ref": {"$ref": "#/$defs/identifier"},
    "attempted_task_skill": {"$ref": "#/$defs/taskSkill"},
    "attempted_physics_primitives": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/physicsPrimitive"}
    },
    "physics_response_ref": {"$ref": "#/$defs/identifier"},
    "safe_decision_ref": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/identifier"}
      ]
    },
    "outcome": {
      "type": "string",
      "enum": ["SUCCESS", "FAILURE", "ABSTAINED", "INTERRUPTED", "UNKNOWN"]
    },
    "failure_mode": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[A-Z0-9_:-]{1,160}$"}
      ]
    },
    "physics_reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scientific_verdict", "binding_reasons", "evidence_refs"],
      "properties": {
        "scientific_verdict": {
          "type": "string",
          "enum": ["FEASIBLE", "INFEASIBLE", "OUT_OF_COVERAGE", "UNKNOWN"]
        },
        "binding_reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z0-9_:-]{1,160}$"}
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "successful_skill": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["task_skill", "physics_primitives"],
          "properties": {
            "task_skill": {"$ref": "#/$defs/taskSkill"},
            "physics_primitives": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/physicsPrimitive"}
            }
          }
        }
      ]
    },
    "reuse_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_scope",
        "envelope_constraints_ref",
        "required_physics_recheck",
        "required_safe_recheck",
        "may_bypass_authorization",
        "expiry_policy",
        "disallow_on_ood"
      ],
      "properties": {
        "target_scope": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,160}$"},
        "envelope_constraints_ref": {"type": "string", "minLength": 1},
        "required_physics_recheck": {"const": true},
        "required_safe_recheck": {"const": true},
        "may_bypass_authorization": {"const": false},
        "expiry_policy": {"const": "REVALIDATE_CURRENT_CONTEXT"},
        "disallow_on_ood": {"const": true}
      }
    },
    "memory_effect": {"const": "ADVISORY_ONLY"},
    "execution_authority": {"const": false}
  },
  "allOf": [
    {
      "if": {
        "properties": {"outcome": {"const": "SUCCESS"}},
        "required": ["outcome"]
      },
      "then": {
        "properties": {"successful_skill": {"not": {"type": "null"}}}
      }
    },
    {
      "if": {
        "properties": {"outcome": {"const": "FAILURE"}},
        "required": ["outcome"]
      },
      "then": {
        "properties": {"failure_mode": {"not": {"type": "null"}}}
      }
    }
  ]
}
