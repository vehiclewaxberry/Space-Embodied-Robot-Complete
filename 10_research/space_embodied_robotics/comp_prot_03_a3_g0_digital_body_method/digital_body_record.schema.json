{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:space-embodied-robotics:comp-prot-03:digital-body-record:v0.1",
  "title": "Space Embodied Intelligence Digital Body Record",
  "$comment": "METHOD CONTRACT ONLY. Structural conformance does not authorize CAD, URDF, dynamics, control, SAFE, RL or VLA and does not upgrade any scientific Gate.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,160}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidenceState": {
      "type": "string",
      "enum": [
        "SOURCE_BOUND",
        "PROVISIONAL",
        "PROPOSED",
        "UNKNOWN",
        "CONFLICTED",
        "DEFERRED",
        "NOT_APPLICABLE"
      ]
    },
    "sourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "path",
        "sha256",
        "authority",
        "qualification",
        "authoritative_fields",
        "limitations"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/identifier"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "authority": {
          "type": "string",
          "enum": [
            "METHOD_CONTRACT",
            "A2_DESIGN_CONTRACT",
            "A2_LOGICAL_MODEL",
            "A2_BLOCKER_LEDGER",
            "A2_GATE",
            "CANONICAL_PROJECT_SOURCE",
            "ACCEPTED_DERIVED_SOURCE",
            "HISTORICAL_REFERENCE"
          ]
        },
        "qualification": {
          "$ref": "#/$defs/evidenceState"
        },
        "authoritative_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "propertyRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property_id",
        "subject_id",
        "evidence_state",
        "value",
        "unit",
        "frame_id",
        "reference_point",
        "configuration_state",
        "source_ref_ids",
        "limitations",
        "unknown_reason",
        "blocked_consumers"
      ],
      "properties": {
        "property_id": {
          "$ref": "#/$defs/identifier"
        },
        "subject_id": {
          "$ref": "#/$defs/identifier"
        },
        "evidence_state": {
          "$ref": "#/$defs/evidenceState"
        },
        "value": {
          "type": [
            "number",
            "string",
            "array",
            "object",
            "boolean",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "frame_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "reference_point": {
          "type": [
            "string",
            "null"
          ]
        },
        "configuration_state": {
          "type": "string",
          "minLength": 1
        },
        "source_ref_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unknown_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "blocked_consumers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_state": {
                "const": "UNKNOWN"
              }
            },
            "required": [
              "evidence_state"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "unknown_reason": {
                "type": "string",
                "minLength": 1
              },
              "blocked_consumers": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_state": {
                "enum": [
                  "SOURCE_BOUND",
                  "PROVISIONAL",
                  "PROPOSED",
                  "CONFLICTED"
                ]
              }
            },
            "required": [
              "evidence_state"
            ]
          },
          "then": {
            "properties": {
              "source_ref_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "geometryEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "entity_type",
        "geometry_state",
        "frame_ids",
        "physical_property_ids",
        "semantic_feature_ids",
        "source_ref_ids",
        "limitations"
      ],
      "properties": {
        "entity_id": {
          "$ref": "#/$defs/identifier"
        },
        "entity_type": {
          "type": "string",
          "enum": [
            "ASSEMBLY",
            "RIGID_BODY",
            "FLEXIBLE_BODY",
            "ARTICULATED_ROBOT",
            "INTERFACE",
            "FRAME",
            "FEATURE",
            "TARGET_BODY"
          ]
        },
        "geometry_state": {
          "$ref": "#/$defs/evidenceState"
        },
        "frame_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "physical_property_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "semantic_feature_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "source_ref_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "frameRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_id",
        "parent_frame_id",
        "transform_ref",
        "evidence_state",
        "source_ref_ids",
        "limitations"
      ],
      "properties": {
        "frame_id": {
          "$ref": "#/$defs/identifier"
        },
        "parent_frame_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "transform_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_state": {
          "$ref": "#/$defs/evidenceState"
        },
        "source_ref_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "representationGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_id",
        "cardinality",
        "members",
        "selected_member",
        "evidence_state",
        "source_ref_ids",
        "limitations"
      ],
      "properties": {
        "group_id": {
          "$ref": "#/$defs/identifier"
        },
        "cardinality": {
          "const": "EXACTLY_ONE"
        },
        "members": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "selected_member": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_state": {
          "$ref": "#/$defs/evidenceState"
        },
        "source_ref_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "massOwnerRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "mass_owner",
        "representation_group",
        "representation_member",
        "active",
        "property_ref_ids",
        "source_ref_ids"
      ],
      "properties": {
        "component_id": {
          "$ref": "#/$defs/identifier"
        },
        "mass_owner": {
          "$ref": "#/$defs/identifier"
        },
        "representation_group": {
          "oneOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "representation_member": {
          "$ref": "#/$defs/identifier"
        },
        "active": {
          "type": "boolean"
        },
        "property_ref_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "source_ref_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "semanticFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_id",
        "owner_entity_id",
        "semantic_type",
        "task_phases",
        "geometry_refs",
        "physical_dependency_refs",
        "allowed_actions",
        "forbidden_actions",
        "evidence_state",
        "evidence_ref_ids",
        "limitations"
      ],
      "properties": {
        "semantic_id": {
          "$ref": "#/$defs/identifier"
        },
        "owner_entity_id": {
          "$ref": "#/$defs/identifier"
        },
        "semantic_type": {
          "type": "string",
          "enum": [
            "OBSERVATION_FEATURE",
            "TASK_INTERFACE",
            "AFFORDANCE_CANDIDATE",
            "CONTACT_PATCH",
            "KEEP_OUT",
            "CONFIGURATION_STATE",
            "CONSTRAINT_INTERFACE",
            "FAILURE_MODE"
          ]
        },
        "task_phases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "geometry_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "physical_dependency_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowed_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "forbidden_actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "evidence_state": {
          "$ref": "#/$defs/evidenceState"
        },
        "evidence_ref_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "traceLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_id",
        "field_ref",
        "evidence_ref_ids",
        "claim_state",
        "maximum_claim",
        "limitations"
      ],
      "properties": {
        "trace_id": {
          "$ref": "#/$defs/identifier"
        },
        "field_ref": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ref_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "claim_state": {
          "type": "string",
          "enum": [
            "METHOD_DEFINED",
            "DESIGN_BOUND",
            "PROVISIONAL_VALUE",
            "HISTORICAL_REFERENCE_ONLY",
            "NOT_EVALUATED"
          ]
        },
        "maximum_claim": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "conflictRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conflict_id",
        "state",
        "source_ref_ids",
        "affected_fields",
        "resolution",
        "blocked_consumers"
      ],
      "properties": {
        "conflict_id": {
          "$ref": "#/$defs/identifier"
        },
        "state": {
          "const": "OPEN"
        },
        "source_ref_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "affected_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "resolution": {
          "type": "string",
          "minLength": 1
        },
        "blocked_consumers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "crossLayerBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "object_ref",
        "geometry_refs",
        "physical_refs",
        "semantic_refs",
        "evidence_refs",
        "status",
        "limitations"
      ],
      "properties": {
        "binding_id": {
          "$ref": "#/$defs/identifier"
        },
        "object_ref": {
          "$ref": "#/$defs/identifier"
        },
        "geometry_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "physical_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "semantic_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "BOUND",
            "PARTIAL",
            "BLOCKED",
            "DEFERRED"
          ]
        },
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "unknownRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unknown_id",
        "field_ref",
        "reason",
        "required_owner",
        "blocks"
      ],
      "properties": {
        "unknown_id": {
          "$ref": "#/$defs/identifier"
        },
        "field_ref": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "required_owner": {
          "$ref": "#/$defs/identifier"
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "consumerRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_id",
        "status",
        "allowed_fields",
        "forbidden_fields",
        "required_closures"
      ],
      "properties": {
        "consumer_id": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "type": "string",
          "enum": [
            "READY",
            "READY_WITH_LIMITATIONS",
            "BLOCKED",
            "NOT_AUTHORIZED",
            "OUT_OF_SCOPE"
          ]
        },
        "allowed_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_closures": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    }
  },
  "required": [
    "schema_version",
    "record_id",
    "phase",
    "created_on",
    "status",
    "authority",
    "parent_records",
    "identity",
    "geometry_layer",
    "physical_layer",
    "semantic_layer",
    "evidence_layer",
    "cross_layer_bindings",
    "unknown_register",
    "consumer_readiness",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "comp-prot-03.digital-body-record.v0.1"
    },
    "record_id": {
      "$ref": "#/$defs/identifier"
    },
    "phase": {
      "const": "COMP-PROT-03-A3-G0-DIGITAL-BODY-METHOD"
    },
    "created_on": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "PARTIAL_WITH_EXPLICIT_UNKNOWNS",
        "REVIEW_READY",
        "REVIEW_READY_WITH_LIMITATIONS",
        "BLOCKED_BY_EVIDENCE"
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scientific_gate",
        "runtime_configuration",
        "cad_generation_authorized",
        "urdf_generation_authorized",
        "simulation_authorized",
        "execution_authority"
      ],
      "properties": {
        "scientific_gate": {
          "const": false
        },
        "runtime_configuration": {
          "const": false
        },
        "cad_generation_authorized": {
          "const": false
        },
        "urdf_generation_authorized": {
          "const": false
        },
        "simulation_authorized": {
          "const": false
        },
        "execution_authority": {
          "const": false
        }
      }
    },
    "parent_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceRecord"
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuration_id",
        "system_role",
        "selected_topology",
        "configuration_state",
        "object_registry_ref"
      ],
      "properties": {
        "configuration_id": {
          "$ref": "#/$defs/identifier"
        },
        "system_role": {
          "type": "string",
          "minLength": 1
        },
        "selected_topology": {
          "$ref": "#/$defs/identifier"
        },
        "configuration_state": {
          "type": "string",
          "minLength": 1
        },
        "object_registry_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "geometry_layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topology_ref",
        "profile_selection",
        "entities",
        "frames"
      ],
      "properties": {
        "topology_ref": {
          "type": "string",
          "minLength": 1
        },
        "profile_selection": {
          "$ref": "#/$defs/propertyRecord"
        },
        "entities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/geometryEntity"
          }
        },
        "frames": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/frameRecord"
          }
        }
      }
    },
    "physical_layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "representation_groups",
        "mass_ownership",
        "properties"
      ],
      "properties": {
        "representation_groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/representationGroup"
          }
        },
        "mass_ownership": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/massOwnerRecord"
          }
        },
        "properties": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/propertyRecord"
          }
        }
      }
    },
    "semantic_layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_scope",
        "features"
      ],
      "properties": {
        "task_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "features": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/semanticFeature"
          }
        }
      }
    },
    "evidence_layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hash_algorithm",
        "hash_mode",
        "source_records",
        "trace_links",
        "conflicts"
      ],
      "properties": {
        "hash_algorithm": {
          "const": "SHA-256"
        },
        "hash_mode": {
          "const": "RAW_BYTES"
        },
        "source_records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceRecord"
          }
        },
        "trace_links": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/traceLink"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conflictRecord"
          }
        }
      }
    },
    "cross_layer_bindings": {
